### 1) register
POST http://localhost:5000/api/auth/register
Content-Type: application/json

{
  "firstName": "Malaz",
  "lastName": "Hassan",
  "email": "malaz@test.com",
  "password": "123456"
}

### 2) weak password (expect 400)
POST http://localhost:5000/api/auth/register
Content-Type: application/json

{
  "firstName": "Test",
  "lastName": "User",
  "email": "weak@test.com",
  "password": "123"
}

### 3) login correct (expect 200)
POST http://localhost:5000/api/auth/login
Content-Type: application/json

{
  "email": "malaz@test.com",
  "password": "123456"
}

### 4) login wrong password (expect 401)
POST http://localhost:5000/api/auth/login
Content-Type: application/json

{
  "email": "malaz@test.com",
  "password": "wrongpass"
}

### 5) upload photo
POST http://localhost:5000/api/photos
Content-Type: multipart/form-data; boundary=XBOUNDARY

--XBOUNDARY
Content-Disposition: form-data; name="userId"

6af22ed156281fbe0be2aac4
--XBOUNDARY
Content-Disposition: form-data; name="title"

My first photo
--XBOUNDARY
Content-Disposition: form-data; name="photo"; filename="test.jpg"
Content-Type: image/jpeg

< ./test.jpg
--XBOUNDARY--

### 6) get all photos
GET http://localhost:5000/api/photos

### 7) register second user
POST http://localhost:5000/api/auth/register
Content-Type: application/json

{
  "firstName": "Other",
  "lastName": "User",
  "email": "other@test.com",
  "password": "123456"
}

### 8) login second user
POST http://localhost:5000/api/auth/login
Content-Type: application/json

{
  "email": "other@test.com",
  "password": "123456"
}

### 9) delete photo as a stranger (expect 403)
DELETE http://localhost:5000/api/photos/6af235dd99517e2dd9412d9b
Content-Type: application/json

{
  "userId": "6af2391799517e2dd9412d9c"
}

### 10) delete photo as the owner (expect 200)
DELETE http://localhost:5000/api/photos/6af235dd99517e2dd9412d9b
Content-Type: application/json

{
  "userId": "6af22ed156281fbe0be2aac4"
}

### 11) add comment
POST http://localhost:5000/api/photos/6afec768799b8c37fb95dfb6/comments
Content-Type: application/json

{ "userId": "6af22ed156281fbe0be2aac4", "comment": "Nice photo!" }

### 12) get comments of a photo
GET http://localhost:5000/api/photos/6afec768799b8c37fb95dfb6/comments

### 13) delete comment as a stranger (expect 403)
DELETE http://localhost:5000/api/comments/6afec7c5799b8c37fb95dfb7
Content-Type: application/json

{ "userId": "6af2391799517e2dd9412d9c" }


### 14) delete comment as the author (expect 200)
DELETE http://localhost:5000/api/comments/6afec7c5799b8c37fb95dfb7
Content-Type: application/json

{ "userId": "6af22ed156281fbe0be2aac4" }

### 15) login and keep the token
# @name login
POST http://localhost:5000/api/auth/login
Content-Type: application/json

{ "email": "malaz@test.com", "password": "123456" }

### 16) save the token in a variable
@token = {{login.response.body.token}}

### 17) add comment WITHOUT token (expect 401)
POST http://localhost:5000/api/photos/6afec768799b8c37fb95dfb6/comments
Content-Type: application/json

{ "comment": "No token" }

### 18) add comment WITH token (expect 201)
POST http://localhost:5000/api/photos/6afec768799b8c37fb95dfb6/comments
Content-Type: application/json
Authorization: Bearer {{token}}

{ "comment": "With token" }